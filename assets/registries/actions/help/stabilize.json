                            {
                                "life_state": "stable"
                            }
                        ],
                        "delivery": "immediate"
                    }
                }
            ]
        }
    },
    "targeting": {
        "kind": "single",
        "range": "5 feet",
        "line_of_sight": {
            "trajectory": "ray"
        },
        "allowed_targets": [
            {
                "life_states": [
                    "normal",
                    "stable",
                    "dead"
                ],
                "invert": true
            }
        ]
    },
