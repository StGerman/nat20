{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SubspeciesDefinition",
    "type": "object",
    "properties": {
        "actions_by_level": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "patternProperties": {
                "^\\d+$": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ActionId"
                    }
                }
            }
        },
        "effects_by_level": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "patternProperties": {
                "^\\d+$": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/EffectId"
                    }
                }
            }
        },
        "id": {
            "$ref": "#/definitions/SubspeciesId"
        },
        "resources_by_level": {
            "description": "Resources granted at each level, e.g. uses of a species feature.",
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "patternProperties": {
                "^\\d+$": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ClassResourceDefinition"
                    }
                }
            }
        }
    },
    "required": [
        "id"
    ],
    "definitions": {
        "ActionId": {
            "description": "Registry id `[namespace::]action.<name>`, e.g. `nat20_core::action.example`. The namespace defaults to `nat20_core`.",
            "type": "string",
            "pattern": "^([A-Za-z0-9_]+::)?action[A-Za-z0-9_.]*$"
        },
        "ClassResourceDefinition": {
            "description": "A resource a class, subclass or species grants at a level, with its budget.",
            "type": "object",
            "properties": {
                "budget": {
                    "$ref": "#/definitions/ResourceBudgetKindDefinition"
                },
                "id": {
                    "$ref": "#/definitions/ResourceId"
                },
                "override": {
                    "type": "boolean",
                    "default": false
                }
            },
            "required": [
                "id",
                "budget"
            ]
        },
        "EffectId": {
            "description": "Registry id `[namespace::]effect.<name>`, e.g. `nat20_core::effect.example`. The namespace defaults to `nat20_core`.",
            "type": "string",
            "pattern": "^([A-Za-z0-9_]+::)?effect[A-Za-z0-9_.]*$"
        },
        "ResourceBudgetKindDefinition": {
            "anyOf": [
                {
                    "description": "A resource budget: `<max uses>` (spawns full) or `<current>/<max>`.",
                    "type": "string",
                    "examples": [
                        "2",
                        "1/4"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "description": "A resource budget: `<max uses>` (spawns full) or `<current>/<max>`.",
                        "type": "string",
                        "examples": [
                            "2",
                            "1/4"
                        ]
                    }
                }
            ]
        },
        "ResourceId": {
            "description": "Registry id `[namespace::]resource.<name>`, e.g. `nat20_core::resource.example`. The namespace defaults to `nat20_core`.",
            "type": "string",
            "pattern": "^([A-Za-z0-9_]+::)?resource[A-Za-z0-9_.]*$"
        },
        "SubspeciesId": {
            "description": "Registry id `[namespace::]subspecies.<name>`, e.g. `nat20_core::subspecies.example`. The namespace defaults to `nat20_core`.",
            "type": "string",
            "pattern": "^([A-Za-z0-9_]+::)?subspecies[A-Za-z0-9_.]*$"
        }
    }
}
