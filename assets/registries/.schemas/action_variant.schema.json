{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ActionVariantDefinition",
    "type": "object",
    "properties": {
        "description": {
            "type": "string"
        },
        "id": {
            "$ref": "#/definitions/ActionVariantId"
        },
        "phases": {
            "description": "Appended to the parent's shared `phases`",
            "type": "array",
            "items": {
                "$ref": "#/definitions/ActionPhaseDefinition"
            }
        },
        "usability": {
            "description": "Checked when this variant is chosen, on top of the parent's `usability`\n(e.g. Help can only assist with a skill you are proficient in)",
            "anyOf": [
                {
                    "$ref": "#/definitions/ActionUsabilityDefinition"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        }
    },
    "required": [
        "id",
        "description",
        "phases"
    ],
    "definitions": {
        "ActionConditionDefinition": {
            "anyOf": [
                {
                    "type": "object",
                    "properties": {
                        "attack_roll": {
                            "description": "How the attack roll is made.",
                            "type": "string",
                            "enum": [
                                "attack_context",
                                "spell_attack_roll"
                            ]
                        }
                    },
                    "required": [
                        "attack_roll"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "saving_throw": {
                            "description": "`<dc provider>;<ability>` where the DC provider is `spell_save_dc`, `weapon_save_dc`, or `spell_save_dc(<class id>)` for a class feature that uses that class's spell save DC outside a spell, e.g. `spell_save_dc;dexterity`.",
                            "type": "string",
                            "examples": [
                                "spell_save_dc;dexterity",
                                "weapon_save_dc;constitution",
                                "spell_save_dc(nat20_core::class.cleric);constitution"
                            ]
                        }
                    },
                    "required": [
                        "saving_throw"
                    ]
                },
                {
                    "description": "Made by the actor rather than the target, and succeeds when the check\ndoes (e.g. Help's DC 10 Wisdom (Medicine) check to stabilize a creature)",
                    "type": "object",
                    "properties": {
                        "skill_check": {
                            "$ref": "#/definitions/SkillCheckDefinition"
                        }
                    },
                    "required": [
                        "skill_check"
                    ]
                }
            ]
        },
        "ActionPayloadComponentDefinition": {
            "anyOf": [
                {
                    "type": "object",
                    "properties": {
                        "damage": {
                            "description": "Damage roll: `<dice expression>;<damage type>` (e.g. `8d6;fire`, `(1 + spell_level)d6;cold`) or `attack_context` to derive the damage roll from the used attack context. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                            "type": "string",
                            "examples": [
                                "8d6;fire",
                                "(1 + spell_level)d4;force",
                                "melee_weapon_damage_roll"
                            ]
                        },
                        "damage_on_failure": {
                            "anyOf": [
                                {
                                    "$ref": "#/definitions/DamageOnFailureDefinition"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        }
                    },
                    "required": [
                        "damage"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "damage": {
                            "description": "Damage roll: `<dice expression>;<damage type>` (e.g. `8d6;fire`, `(1 + spell_level)d6;cold`) or `attack_context` to derive the damage roll from the used attack context. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                            "type": "string",
                            "examples": [
                                "8d6;fire",
                                "(1 + spell_level)d4;force",
                                "melee_weapon_damage_roll"
                            ]
                        }
                    },
                    "required": [
                        "damage"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "effect": {
                            "$ref": "#/definitions/EffectInstanceDefinition"
                        }
                    },
                    "required": [
                        "effect"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "healing": {
                            "description": "Healing roll as a dice expression. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                            "type": "string",
                            "examples": [
                                "1d8 + spell_level",
                                "2d4 + 2"
                            ]
                        }
                    },
                    "required": [
                        "healing"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "reaction": {
                            "description": "Script id of a Lua reaction body, e.g. `nat20_core::script.shield`, or the built-in `cancel_event`.",
                            "type": "string",
                            "examples": [
                                "nat20_core::script.shield",
                                "cancel_event"
                            ]
                        }
                    },
                    "required": [
                        "reaction"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "displacement": {
                            "$ref": "#/definitions/DisplacementTemplateDefinition"
                        }
                    },
                    "required": [
                        "displacement"
                    ]
                },
                {
                    "description": "Changes the target's life state when the condition succeeds",
                    "type": "object",
                    "properties": {
                        "life_state": {
                            "$ref": "#/definitions/LifeStateChange"
                        }
                    },
                    "required": [
                        "life_state"
                    ]
                }
            ]
        },
        "ActionPayloadDefinition": {
            "type": "object",
            "properties": {
                "components": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "$ref": "#/definitions/ActionPayloadComponentDefinition"
                    }
                },
                "delivery": {
                    "$ref": "#/definitions/PayloadDeliveryDefinition"
                }
            },
            "required": [
                "delivery"
            ]
        },
        "ActionPhaseDefinition": {
            "type": "object",
            "properties": {
                "condition": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/ActionConditionDefinition"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "payload": {
                    "$ref": "#/definitions/ActionPayloadDefinition"
                },
                "requires": {
                    "description": "Gate on the previous phase's condition outcome (per target)",
                    "allOf": [
                        {
                            "$ref": "#/definitions/PhaseRequirement"
                        }
                    ],
                    "default": "none"
                },
                "targets": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/PhaseTargetsDefinition"
                        }
                    ],
                    "default": "inherited"
                }
            },
            "required": [
                "payload"
            ]
        },
        "ActionUsabilityDefinition": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "script": {
                            "$ref": "#/definitions/ScriptId"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "script"
                    ]
                },
                {
                    "description": "The actor must be proficient in this skill",
                    "type": "object",
                    "properties": {
                        "skill_proficiency": {
                            "$ref": "#/definitions/Skill"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "skill_proficiency"
                    ]
                }
            ]
        },
        "ActionVariantId": {
            "description": "Registry id `[namespace::]variant.<name>`, e.g. `nat20_core::variant.example`. The namespace defaults to `nat20_core`.",
            "type": "string",
            "pattern": "^([A-Za-z0-9_]+::)?variant[A-Za-z0-9_.]*$"
        },
        "AreaShapeDefinition": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "actor"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "sphere": {
                            "type": "object",
                            "properties": {
                                "radius": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "radius"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "sphere"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "cone": {
                            "type": "object",
                            "properties": {
                                "angle": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `deg`/`degree(s)`, `rad`/`radian(s)`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                },
                                "length": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "angle",
                                "length"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "cone"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "cube": {
                            "type": "object",
                            "properties": {
                                "side": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "side"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "cube"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "cylinder": {
                            "type": "object",
                            "properties": {
                                "height": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                },
                                "radius": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "radius",
                                "height"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "cylinder"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "line": {
                            "type": "object",
                            "properties": {
                                "length": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                },
                                "width": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "length",
                                "width"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "line"
                    ]
                }
            ]
        },
        "D20CheckKindTag": {
            "description": "Auto-generated discriminant enum variants",
            "type": "string",
            "enum": [
                "saving_throw",
                "skill",
                "attack_roll"
            ]
        },
        "DamageOnFailureDefinition": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "half"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "custom": {
                            "description": "Damage roll: `<dice expression>;<damage type>` (e.g. `8d6;fire`, `(1 + spell_level)d6;cold`) or `attack_context` to derive the damage roll from the used attack context. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                            "type": "string",
                            "examples": [
                                "8d6;fire",
                                "(1 + spell_level)d4;force",
                                "melee_weapon_damage_roll"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "custom"
                    ]
                }
            ]
        },
        "DisplacementTemplateDefinition": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "teleport"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "push": {
                            "type": "object",
                            "properties": {
                                "distance": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "distance"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "push"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "pull": {
                            "type": "object",
                            "properties": {
                                "distance": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m`/`meter(s)`, `ft`/`foot`/`feet`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "distance"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "pull"
                    ]
                }
            ]
        },
        "EffectEndConditionDefinition": {
            "type": "object",
            "properties": {
                "event": {
                    "$ref": "#/definitions/EffectEventFilterDefinition"
                },
                "on_trigger": {
                    "$ref": "#/definitions/EffectEndVerb"
                }
            },
            "required": [
                "event",
                "on_trigger"
            ]
        },
        "EffectEndVerb": {
            "oneOf": [
                {
                    "description": "Remove the effect instance when the event fires",
                    "type": "string",
                    "const": "remove"
                },
                {
                    "description": "Re-roll the applying action's condition and remove the effect on a\nsuccess (e.g. Hold Person's repeat save)",
                    "type": "string",
                    "const": "repeat_apply_condition"
                }
            ]
        },
        "EffectEntiyReference": {
            "type": "string",
            "enum": [
                "applier",
                "target"
            ]
        },
        "EffectEventFilterDefinition": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "turn_boundary": {
                            "type": "object",
                            "properties": {
                                "boundary": {
                                    "$ref": "#/definitions/TurnBoundary"
                                },
                                "entity": {
                                    "$ref": "#/definitions/EffectEntiyReference"
                                }
                            },
                            "required": [
                                "entity",
                                "boundary"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "turn_boundary"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "d20_check": {
                            "type": "object",
                            "properties": {
                                "against": {
                                    "description": "Who the roll is made against. Only attack rolls have a target, so a\nfilter with `against` never matches saving throws or skill checks.",
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/EffectEntiyReference"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "default": null
                                },
                                "kind": {
                                    "$ref": "#/definitions/D20CheckKindTag"
                                },
                                "roller": {
                                    "description": "Who makes the roll. Omit to match any roller.",
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/EffectEntiyReference"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "default": null
                                },
                                "skill": {
                                    "description": "Only match checks made with this skill (e.g. Help's Advantage is spent\nby the next check with the chosen skill). Omit to match any skill.",
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/Skill"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "default": null
                                }
                            },
                            "required": [
                                "kind"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "d20_check"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "script": {
                            "type": "object",
                            "properties": {
                                "events": {
                                    "description": "Event kinds this filter can match",
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/EventKindTag"
                                    }
                                },
                                "script": {
                                    "$ref": "#/definitions/ScriptId"
                                }
                            },
                            "required": [
                                "events",
                                "script"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "script"
                    ]
                }
            ]
        },
        "EffectId": {
            "description": "Registry id `[namespace::]effect.<name>`, e.g. `nat20_core::effect.example`. The namespace defaults to `nat20_core`.",
            "type": "string",
            "pattern": "^([A-Za-z0-9_]+::)?effect[A-Za-z0-9_.]*$"
        },
        "EffectInstanceDefinition": {
            "type": "object",
            "properties": {
                "effect_id": {
                    "$ref": "#/definitions/EffectId"
                },
                "end_condition": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/EffectEndConditionDefinition"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "lifetime": {
                    "$ref": "#/definitions/EffectLifetimeTemplate"
                }
            },
            "required": [
                "effect_id",
                "lifetime"
            ]
        },
        "EffectLifetimeTemplate": {
            "description": "Effect lifetimes are unique in the sense that they can refer to different entities,\nbut those entities are only known at runtime. Therefore, we need a template\nthat can be instantiated into a concrete `EffectLifetime` when the effect is applied.",
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "permanent"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "turn_boundary": {
                            "type": "object",
                            "properties": {
                                "boundary": {
                                    "$ref": "#/definitions/TurnBoundary"
                                },
                                "duration": {
                                    "$ref": "#/definitions/TimeDurationDefinition"
                                },
                                "entity": {
                                    "$ref": "#/definitions/EffectEntiyReference"
                                }
                            },
                            "required": [
                                "entity",
                                "boundary",
                                "duration"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "turn_boundary"
                    ]
                }
            ]
        },
        "EventKindTag": {
            "description": "Auto-generated discriminant enum variants",
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "encounter",
                        "life_state_changed",
                        "damage_roll_performed",
                        "damage_roll_resolved",
                        "turn_boundary",
                        "rest_started",
                        "rest_finished",
                        "lost_concentration",
                        "moving_out_of_reach",
                        "equipment_changed"
                    ]
                },
                {
                    "description": "An entity has declared they want to take an action. The engine can then\nvalidate that the entity can perform the action and either approve or\ndeny it. Other entities might also react to the request, e.g. if someone\nis casting a spell, another entity might use their reaction to Counterspell\nthe action.",
                    "type": "string",
                    "const": "action_requested"
                },
                {
                    "description": "The result of performing an action.\nDespite the name it can also be used outside of actions.\nTODO: Maybe a better name then?",
                    "type": "string",
                    "const": "action_result"
                },
                {
                    "description": "The initial D20 roll which can be reacted to, e.g. with the Lucky feat.",
                    "type": "string",
                    "const": "d20_check_performed"
                },
                {
                    "description": "The final result of a D20 check after reactions have been applied.",
                    "type": "string",
                    "const": "d20_check_resolved"
                }
            ]
        },
        "LifeStateChange": {
            "description": "A change to a creature's life state that an action makes directly, rather\nthan through damage or healing.",
            "oneOf": [
                {
                    "description": "\"A Stable creature doesn't make Death Saving Throws even though it has 0\nHit Points, but it still has the Unconscious condition.\" Only a creature\nthat is making Death Saving Throws can become Stable; any other creature\nis unaffected.",
                    "type": "string",
                    "const": "stable"
                }
            ]
        },
        "PayloadDeliveryDefinition": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "immediate"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "projectile": {
                            "type": "object",
                            "properties": {
                                "trajectory": {
                                    "$ref": "#/definitions/TrajectoryTemplateDefinition"
                                },
                                "velocity": {
                                    "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `m/s`, `ft/s`, `km/h`, `mph`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "trajectory",
                                "velocity"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "projectile"
                    ]
                }
            ]
        },
        "PhaseRequirement": {
            "description": "In case of multiple phases, this describes the requirement for a phase to be\nexecuted, e.g. only execute if the previous phase succeeded or failed.",
            "type": "string",
            "enum": [
                "none",
                "success",
                "failure"
            ]
        },
        "PhaseTargetsDefinition": {
            "description": "How a phase derives its targets. Follow-up phases never re-select targets;\nthey either inherit the action's chosen targets or expand each of them into\nthe entities inside a shape centered on it (e.g. Ice Knife's 5 ft AoE damage).",
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "inherited",
                        "actor"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "shape": {
                            "$ref": "#/definitions/AreaShapeDefinition"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "shape"
                    ]
                }
            ]
        },
        "ScriptId": {
            "description": "Registry id `[namespace::]script.<name>`, e.g. `nat20_core::script.example`. The namespace defaults to `nat20_core`.",
            "type": "string",
            "pattern": "^([A-Za-z0-9_]+::)?script[A-Za-z0-9_.]*$"
        },
        "Skill": {
            "type": "string",
            "enum": [
                "athletics",
                "acrobatics",
                "sleight_of_hand",
                "stealth",
                "initiative",
                "arcana",
                "history",
                "investigation",
                "nature",
                "religion",
                "animal_handling",
                "insight",
                "medicine",
                "perception",
                "survival",
                "deception",
                "intimidation",
                "performance",
                "persuasion"
            ]
        },
        "SkillCheckDefinition": {
            "description": "A skill check the actor makes against a fixed DC, e.g. \"a successful DC 10\nWisdom (Medicine) check\" to stabilize a creature",
            "type": "object",
            "properties": {
                "dc": {
                    "description": "The DC the check has to meet or beat to succeed",
                    "type": "integer",
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0
                },
                "skill": {
                    "description": "The skill the actor makes the check with",
                    "allOf": [
                        {
                            "$ref": "#/definitions/Skill"
                        }
                    ]
                }
            },
            "required": [
                "skill",
                "dc"
            ]
        },
        "TimeDurationDefinition": {
            "anyOf": [
                {
                    "type": "object",
                    "properties": {
                        "time": {
                            "description": "`<integer expression> <unit>` (e.g. `10 + spell_level ft` for a length) where the unit is one of `s`/`sec`/`second(s)`, `min`/`minute(s)`, `hr`/`hour(s)`. Expressions may use the variables `spell_level`, `caster_level`, `character_level` and `<class>.level` (e.g. `class.wizard.level`).",
                            "type": "string"
                        }
                    },
                    "required": [
                        "time"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "turns": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                        }
                    },
                    "required": [
                        "turns"
                    ]
                }
            ]
        },
        "TrajectoryTemplateDefinition": {
            "type": "string",
            "enum": [
                "ray",
                "parabola"
            ]
        },
        "TurnBoundary": {
            "type": "string",
            "enum": [
                "start",
                "end"
            ]
        }
    }
}
